{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "s-tournament-score-relay",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "durable_objects": {"bindings": [{"name": "SCORES", "class_name": "ScoreRoom"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ScoreRoom"]}],
  "vars": {
    "ALLOWED_ORIGINS": "https://s-tournament-system.vercel.app",
    "SOURCE_URL": "https://s-tournament-system.vercel.app/api/public/scoreboard",
    "MAX_CONNECTIONS": "1200"
  },
  "observability": {"enabled": true, "head_sampling_rate": 0.1}
}
