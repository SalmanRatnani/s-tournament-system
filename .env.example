# Leave these unset to use the CLEARLY LABELED local demo mode.
# All three required for production; NEVER prefix SERVICE_ROLE with NEXT_PUBLIC_!
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only: generate an independent 32+ character random secret. Never prefix NEXT_PUBLIC_.
OBS_OVERLAY_SIGNING_SECRET=

# Public relay base URL (HTTPS), e.g. https://s-tournament-score-relay.<account>.workers.dev
# No NEXT_PUBLIC prefix needed: /api/public/event exposes only the safe WebSocket URL.
PUBLIC_SCORE_RELAY_URL=
# Server-only, 32+ random characters, identical to Cloudflare's PUBLISH_SECRET.
SCORE_RELAY_PUBLISH_SECRET=
